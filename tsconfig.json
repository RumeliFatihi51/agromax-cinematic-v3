{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "allowJs": true, "checkJs": false,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "types": ["node", "vite/client"], "plugins": [{ "name": "workflow" }]
  },
  "include": ["commercial/**/*.ts", "shared/contracts/**/*.ts", "src/**/*.ts", "src/**/*.tsx", "workflows/**/*.ts", "runtime/**/*.ts", "scripts/**/*.ts", "e2e/**/*.ts", "playwright.config.ts", "vite.config.ts", "drizzle.config.ts"]
}
