# .env olarak kopyalayın. Bu dosyaya gerçek secret yazmayın.
# sentinelhub veya cdse; ID'yi oluşturduğunuz panelle eşleşmeli.
SENTINEL_PROVIDER=
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# Optional USGS Landsat COG access using AWS SDK credentials and Requester Pays.
# The public STAC catalogue remains available with raster access off.
AGROMAX_LANDSAT_AWS_ENABLED=false

# Yer araması: geliştirmede Photon demo; ticari ölçekte kendi/ücretli servisinize geçin.
GEOCODING_URL=https://photon.komoot.io/api/

# NASA Open APIs key and separate NASA Earthdata bearer token; server-only.
NASA_API_KEY=
EARTHDATA_TOKEN=

# Vercel: Neon integration supplies this server-only value automatically.
# Leave unset for the local SQLite development database.
# DATABASE_URL=

# Commercial runtime: use a separate PostgreSQL branch/database for staging.
# The legacy DATABASE_URL is never selected implicitly by this runtime.
AGROMAX_DATABASE_URL=
AGROMAX_AUTH_SECRET=
AGROMAX_APP_URL=http://127.0.0.1:5180
AGROMAX_LOCAL_DATA_DIR=data/commercial-pg
AGROMAX_LOCAL_OBJECT_DIR=data/private-objects
# Explicit local development only. The full commercial runtime enforces entitlements on Vercel.
AGROMAX_ENFORCE_QUOTAS=true
AGROMAX_SALES_ENABLED=false

# Commercial verification and reset messages. Configure both with a verified sender.
AGROMAX_RESEND_API_KEY=
AGROMAX_MAIL_FROM=

# Private Vercel Blob; server only. Marketplace/CLI supplies the real value.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=

# Model connection is on hold at the user's request.
AGROMAX_FILIZ_ENABLED=false
AGROMAX_FILIZ_MODEL=
AI_GATEWAY_API_KEY=

# Existing-account workspace adapter; preserves current login and parcel APIs.
# Enable only after reviewed additive migrations. Its database must explicitly
# match DATABASE_URL. Sales stay closed; report requests are limited to 10/day.
AGROMAX_WORKSPACE_ENABLED=false
